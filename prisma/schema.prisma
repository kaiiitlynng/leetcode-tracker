generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app; direct connection for migrations (Neon's pooler can't run them).
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  problems     Problem[]
  sessions     Session[]
}

/// One signed-in browser. The id is the SHA-256 of the cookie token, so a leaked DB row can't be replayed.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Problems belong to one account; everything else (attempts, review state) hangs off a problem.
model Problem {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lcNumber   Int?
  slug       String
  title      String
  leetcodeUrl String?
  neetcodeUrl String?
  difficulty String
  topics     String       @default("[]")
  pattern    String?
  notes      String?
  lists      String       @default("[]")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  attempts   Attempt[]
  review     ReviewState?

  @@unique([userId, slug])
  @@unique([userId, lcNumber])
}

model Attempt {
  id              String   @id @default(cuid())
  problemId       String
  problem         Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  attemptedAt     DateTime
  outcome         String
  rating          Int
  timeMinutes     Int?
  language        String?
  approach        String?
  timeComplexity  String?
  spaceComplexity String?
  mistakes        String?
  code            String?
  isReview        Boolean  @default(false)
  source          String   @default("manual")
  notionPage      String?
  createdAt        DateTime @default(now())

  @@index([problemId, attemptedAt])
}

model ReviewState {
  problemId      String   @id
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  easeFactor     Float    @default(2.5)
  intervalDays   Int      @default(0)
  repetitions    Int      @default(0)
  lapses         Int      @default(0)
  dueAt          DateTime
  lastReviewedAt DateTime?
  suspended      Boolean  @default(false)
}
